# Base URL for the SJS Cloudflare Worker. Local Wrangler default:
VITE_WORKER_API_URL=http://127.0.0.1:8787

# Firebase web app configuration (public client values)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_APP_ID=1:827720641620:web:local-dev
VITE_FIREBASE_AUTH_DOMAIN=sjs-be.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sjs-be

# Development uses the Firebase Auth and Firestore emulators by default.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_DEV_AUTH_EMAIL=dev@example.test
VITE_DEV_AUTH_PASSWORD=dev-password
